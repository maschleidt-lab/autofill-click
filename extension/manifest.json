{
  "manifest_version": 3,
  "name": "Auto-fill keybind",
  "version": "0.1.0",
  "description": "Clicks the autofill button within the Atlas browser extension.",

  "action": {
    "default_title": "Auto-fill keybind",
    "default_popup": "popup/popup.html"
  },

  "permissions": ["storage"],

  "browser_specific_settings": {
    "gecko": {
      "id": "double-check@maschleidt.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}